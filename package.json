{
  "name": "books-read",
  "version": "1.0.0",
  "private": true,
  "description": "A simple site to record the books I've read.",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "check": "npm run build && html-validate \"_site/**/*.html\" && node scripts/check-links.js",
    "new": "node scripts/new-book.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwhenson/books-read.git"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "html-validate": "^11.16.0",
    "sass": "^1.105.0"
  }
}
